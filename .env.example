# Copia como .env. No publiques este archivo con valores reales.
NODE_ENV=production
PORT=3000
# En despliegues sin Docker, apunta esta ruta al volumen persistente.
AULA_DATA_DIR=./data
AULA_PUBLIC_URL=https://aula.tudominio.com
# Se utiliza solo al crear el primer perfil; no cambia contrasenas existentes.
TEACHER_PASSWORD=
# Activa solo si el puerto de Node esta protegido detras de tu proxy HTTPS.
AULA_TRUST_PROXY=1
# Declara 1 solo despues de comprobar que el volumen conserva datos.
AULA_PERSISTENT_STORAGE=1
AULA_MAX_CONNECTIONS=1200
